# Multi-stage Dockerfile that builds Penpot frontend and backend from source
# and combines them into a single container with configurable PORT

# Stage 1: Build dependencies setup (Java, Node.js)
FROM ubuntu:24.04 AS build-deps
LABEL maintainer="Penpot <docker@penpot.app>"

ENV LANG='C.UTF-8' \
    LC_ALL='C.UTF-8' \
    JAVA_HOME="/opt/jdk" \
    DEBIAN_FRONTEND=noninteractive \
    NODE_VERSION=v22.19.0 \
    TZ=Etc/UTC

RUN set -ex; \
    apt-get -qq update; \
    apt-get -qq upgrade; \
    apt-get -qqy --no-install-recommends install \
        binutils \
        ca-certificates \
        curl \
        git \
        bash \
        rsync \
        sed \
        coreutils \
    ; \
    rm -rf /var/lib/apt/lists/*

# Install Node.js
RUN set -eux; \
    ARCH="$(dpkg --print-architecture)"; \
    case "${ARCH}" in \
       aarch64|arm64) \
         OPENSSL_ARCH='linux-aarch64'; \
         BINARY_URL="https://nodejs.org/dist/${NODE_VERSION}/node-${NODE_VERSION}-linux-arm64.tar.gz"; \
         ;; \
       amd64|x86_64) \
         OPENSSL_ARCH='linux-x86_64'; \
         BINARY_URL="https://nodejs.org/dist/${NODE_VERSION}/node-${NODE_VERSION}-linux-x64.tar.gz"; \
         ;; \
       *) \
         echo "Unsupported arch: ${ARCH}"; \
         exit 1; \
         ;; \
    esac; \
    curl -LfsSo /tmp/nodejs.tar.gz ${BINARY_URL}; \
    mkdir -p /opt/node; \
    cd /opt/node; \
    tar -xf /tmp/nodejs.tar.gz --strip-components=1; \
    chown -R root /opt/node; \
    find /opt/node/include/node/openssl/archs -mindepth 1 -maxdepth 1 ! -name "$OPENSSL_ARCH" -exec rm -rf {} \; ; \
    rm -rf /tmp/nodejs.tar.gz;

# Install Java
RUN set -eux; \
    ARCH="$(dpkg --print-architecture)"; \
    case "${ARCH}" in \
       aarch64|arm64) \
         ESUM='6f8725d186d05c627176db9c46c732a6ef3ba41d9e9b3775c4727fc8ac642bb2'; \
         BINARY_URL='https://github.com/adoptium/temurin24-binaries/releases/download/jdk-24.0.2%2B12/OpenJDK24U-jdk_aarch64_linux_hotspot_24.0.2_12.tar.gz'; \
         ;; \
       amd64|x86_64) \
         ESUM='aea1cc55e51cf651c85f2f00ad021603fe269c4bb6493fa97a321ad770c9b096'; \
         BINARY_URL='https://github.com/adoptium/temurin24-binaries/releases/download/jdk-24.0.2%2B12/OpenJDK24U-jdk_x64_linux_hotspot_24.0.2_12.tar.gz'; \
         ;; \
       *) \
         echo "Unsupported arch: ${ARCH}"; \
         exit 1; \
         ;; \
    esac; \
    curl -LfsSo /tmp/openjdk.tar.gz ${BINARY_URL}; \
    echo "${ESUM} */tmp/openjdk.tar.gz" | sha256sum -c -; \
    mkdir -p /opt/jdk; \
    cd /opt/jdk; \
    tar -xf /tmp/openjdk.tar.gz --strip-components=1; \
    rm -rf /tmp/openjdk.tar.gz; \
    /opt/jdk/bin/jlink \
       --no-header-files \
       --no-man-pages \
       --strip-debug \
       --add-modules java.base,jdk.management.agent,java.se,jdk.compiler,jdk.javadoc,jdk.attach,jdk.unsupported \
       --output /opt/jre;

ENV PATH=/opt/jre/bin:/opt/node/bin:$PATH

# Install Clojure CLI
RUN curl -L -O https://github.com/clojure/brew-install/releases/latest/download/linux-install.sh && \
    chmod +x linux-install.sh && \
    ./linux-install.sh && \
    rm linux-install.sh

# Install Babashka
RUN curl -sLO https://raw.githubusercontent.com/babashka/babashka/master/install && \
    chmod +x install && \
    ./install && \
    rm install

# Stage 2: Build frontend
FROM build-deps AS build-frontend

WORKDIR /build

# Copy source for frontend build including vendor dependencies
COPY frontend frontend/
COPY render-wasm render-wasm/
COPY common common/
COPY .git .git/
COPY .yarnrc.yml .yarnrc.yml
COPY yarn.lock yarn.lock
COPY package.json package.json

WORKDIR /build/frontend

# Enable corepack and install dependencies
RUN corepack enable && \
    corepack install

# Install root dependencies first, then frontend dependencies
WORKDIR /build
RUN yarn install

WORKDIR /build/frontend
RUN yarn install

# Build frontend
ENV NODE_ENV=production \
    INCLUDE_STORYBOOK=no \
    INCLUDE_WASM=yes

# Set build variables
RUN export CURRENT_VERSION=$(git describe --tags --match "*.*.*" 2>/dev/null || echo "develop") && \
    export BUILD_DATE=$(date -R) && \
    export CURRENT_HASH=$(git rev-parse --short HEAD) && \
    export TS=$(date +%s) && \
    echo "Building frontend with version: $CURRENT_VERSION" && \
    echo "Build date: $BUILD_DATE" && \
    echo "Hash: $CURRENT_HASH"

# Clean and build main app
RUN rm -rf resources/public target/dist && \
    export CURRENT_HASH=$(git rev-parse --short HEAD) && \
    export TS=$(date +%s) && \
    yarn run build:app:main --config-merge "{:release-version \"${CURRENT_HASH}-${TS}\"}"

# Build WASM component
RUN yarn run build:wasm

# Build libraries and assets  
RUN yarn run build:app:libs && \
    yarn run build:app:assets

# Create distribution directory and copy files
RUN mkdir -p target/dist && \
    rsync -avr resources/public/ target/dist/

# Update version and build date in HTML files
RUN export CURRENT_VERSION=$(git describe --tags --match "*.*.*" 2>/dev/null || echo "develop") && \
    export BUILD_DATE=$(date -R) && \
    sed -i -e "s/%version%/$CURRENT_VERSION/g" ./target/dist/index.html && \
    sed -i -e "s/%version%/$CURRENT_VERSION/g" ./target/dist/render.html && \
    sed -i -e "s/%version%/$CURRENT_VERSION/g" ./target/dist/rasterizer.html && \
    sed -i -e "s/%buildDate%/$BUILD_DATE/g" ./target/dist/index.html && \
    sed -i -e "s/%buildDate%/$BUILD_DATE/g" ./target/dist/rasterizer.html && \
    sed -i "s/version=develop/version=$CURRENT_VERSION/g" ./target/dist/js/render_wasm.js

# Stage 3: Build backend
FROM build-deps AS build-backend

WORKDIR /build

# Copy source for backend build
COPY backend backend/
COPY common common/
COPY .git .git/
COPY CHANGES.md CHANGES.md

WORKDIR /build/backend

# Build backend
RUN export CURRENT_VERSION=$(git describe --tags --match "*.*.*" 2>/dev/null || echo "develop") && \
    rm -rf target && \
    mkdir -p target/classes target/dist target/dist/scripts && \
    echo "$CURRENT_VERSION" > target/classes/version.txt && \
    cp ../CHANGES.md target/classes/changelog.md && \
    clojure -T:build jar && \
    mv target/penpot.jar target/dist/penpot.jar && \
    cp resources/log4j2.xml target/dist/log4j2.xml && \
    cp scripts/run.template.sh target/dist/run.sh && \
    cp scripts/manage.py target/dist/manage.py && \
    cp scripts/svgo-cli.js target/dist/scripts/ && \
    chmod +x target/dist/run.sh && \
    chmod +x target/dist/manage.py && \
    rm -rf builtin-templates && \
    mkdir builtin-templates && \
    bb ./scripts/prefetch-templates.clj resources/app/onboarding.edn builtin-templates/ && \
    cp -r builtin-templates target/dist/

# Stage 4: Final runtime image
FROM ubuntu:24.04 AS final
LABEL maintainer="Penpot <docker@penpot.app>"

ENV LANG='C.UTF-8' \
    LC_ALL='C.UTF-8' \
    JAVA_HOME="/opt/jre" \
    PATH=/opt/jre/bin:/opt/node/bin:/opt/imagick/bin:$PATH \
    DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC \
    PORT=8080

USER root

RUN set -ex; \
    useradd -U -M -u 1001 -s /bin/false -d /opt/penpot penpot; \
    apt-get -qq update; \
    apt-get -qq upgrade; \
    apt-get -qqy --no-install-recommends install \
        ca-certificates \
        curl \
        fontconfig \
        fontforge \
        libfontconfig1 \
        libfreetype6 \
        libglib2.0-0 \
        libgomp1 \
        libheif1 \
        libjpeg-turbo8 \
        liblcms2-2 \
        libopenexr-3-1-30 \
        libopenjp2-7 \
        libpng16-16 \
        librsvg2-2 \
        libtiff6 \
        libwebp7 \
        libwebpdemux2 \
        libwebpmux3 \
        libxml2 \
        libzip4t64 \
        libzstd1 \
        python3 \
        python3-tabulate \
        tzdata \
        woff-tools \
        woff2 \
        supervisor \
        nginx \
        gettext-base \
    ; \
    mkdir -p /opt/data/assets; \
    mkdir -p /opt/penpot; \
    chown -R penpot:penpot /opt/penpot; \
    chown -R penpot:penpot /opt/data; \
    mkdir -p /etc/nginx/overrides/http.d/; \
    mkdir -p /etc/nginx/overrides/server.d/; \
    mkdir -p /etc/nginx/overrides/location.d/; \
    chown -R penpot:penpot /etc/nginx/overrides/; \
    mkdir -p /var/www; \
    chown -R penpot:penpot /var/www; \
    mkdir -p /var/cache/nginx; \
    chown -R penpot:penpot /var/cache/nginx; \
    mkdir -p /var/log/nginx; \
    chown -R penpot:penpot /var/log/nginx; \
    mkdir -p /tmp/nginx; \
    chown -R penpot:penpot /tmp/nginx; \
    rm -rf /var/lib/apt/lists/*;

# Copy runtime dependencies
COPY --from=build-deps /opt/jre /opt/jre
COPY --from=build-deps /opt/node /opt/node
COPY --from=penpotapp/imagemagick:7.1.2-0 /opt/imagick /opt/imagick

# Copy built applications
COPY --chown=penpot:penpot --from=build-backend /build/backend/target/dist /opt/penpot/backend/
COPY --from=build-frontend /build/frontend/target/dist /var/www/app/

# Copy configuration files
COPY ./docker/images/files/config.js /var/www/app/js/config.js
COPY ./docker/images/files/nginx.conf.template /tmp/nginx.conf.template
COPY ./docker/images/files/nginx-resolvers.conf.template /tmp/resolvers.conf.template
COPY ./docker/images/files/nginx-mime.types /etc/nginx/mime.types
COPY ./docker/images/files/nginx-external-locations.conf /etc/nginx/overrides/location.d/external-locations.conf

# Fix permissions for config.js so penpot user can modify it
RUN chown penpot:penpot /var/www/app/js/config.js

# Create nginx configuration template with configurable PORT
RUN printf 'worker_processes auto;\n\
pid /tmp/nginx.pid;\n\
include /etc/nginx/overrides/main.d/*.conf;\n\
\n\
events {\n\
    worker_connections 2048;\n\
    multi_accept on;\n\
}\n\
\n\
http {\n\
    client_body_temp_path /tmp/client_temp;\n\
    proxy_temp_path       /tmp/proxy_temp_path;\n\
    fastcgi_temp_path     /tmp/fastcgi_temp;\n\
    uwsgi_temp_path       /tmp/uwsgi_temp;\n\
    scgi_temp_path        /tmp/scgi_temp;\n\
\n\
    sendfile on;\n\
    tcp_nopush on;\n\
    tcp_nodelay on;\n\
    keepalive_requests 30;\n\
    keepalive_timeout 65;\n\
    types_hash_max_size 2048;\n\
\n\
    server_tokens off;\n\
\n\
    reset_timedout_connection on;\n\
    client_body_timeout 30s;\n\
    client_header_timeout 30s;\n\
\n\
    include /etc/nginx/mime.types;\n\
    default_type application/octet-stream;\n\
\n\
    error_log /dev/stderr;\n\
    access_log /dev/stdout;\n\
\n\
    proxy_connect_timeout 300s;\n\
    proxy_send_timeout 300s;\n\
    proxy_read_timeout 300s;\n\
    send_timeout 300s;\n\
\n\
    gzip on;\n\
    gzip_vary on;\n\
    gzip_proxied any;\n\
    gzip_static on;\n\
    gzip_comp_level 4;\n\
    gzip_buffers 16 8k;\n\
    gzip_http_version 1.1;\n\
\n\
    gzip_types text/plain text/css text/javascript application/javascript application/json application/transit+json image/svg+xml;\n\
\n\
    proxy_buffer_size 16k;\n\
    proxy_busy_buffers_size 24k;\n\
    proxy_buffers 32 4k;\n\
\n\
    map $http_upgrade $connection_upgrade {\n\
        default upgrade;\n\
        '"'"''"'"'      close;\n\
    }\n\
\n\
    proxy_cache_path /tmp/cache/ levels=2:2 keys_zone=penpot:20m;\n\
    proxy_cache_methods GET HEAD;\n\
    proxy_cache_valid any 48h;\n\
    proxy_cache_key "$host$request_uri";\n\
\n\
    proxy_http_version 1.1;\n\
    proxy_set_header Host $http_host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Scheme $scheme;\n\
    proxy_set_header X-Forwarded-Proto $scheme;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
\n\
    include /etc/nginx/overrides/http.d/*.conf;\n\
\n\
    server {\n\
        listen ${PORT} default_server;\n\
        server_name _;\n\
\n\
        client_max_body_size $PENPOT_HTTP_SERVER_MAX_MULTIPART_BODY_SIZE;\n\
        charset utf-8;\n\
\n\
        etag off;\n\
\n\
        root /var/www/app/;\n\
\n\
        location @handle_redirect {\n\
            set $redirect_uri "$upstream_http_location";\n\
            set $redirect_host "$upstream_http_x_host";\n\
            set $redirect_cache_control "$upstream_http_cache_control";\n\
            set $real_mtype "$upstream_http_x_mtype";\n\
\n\
            proxy_buffering off;\n\
\n\
            proxy_set_header Host "$redirect_host";\n\
            proxy_hide_header etag;\n\
            proxy_hide_header x-amz-id-2;\n\
            proxy_hide_header x-amz-request-id;\n\
            proxy_hide_header x-amz-meta-server-side-encryption;\n\
            proxy_hide_header x-amz-server-side-encryption;\n\
            proxy_ssl_server_name on;\n\
            proxy_pass $redirect_uri;\n\
\n\
            add_header x-internal-redirect "$redirect_uri";\n\
            add_header x-cache-control "$redirect_cache_control";\n\
            add_header cache-control "$redirect_cache_control";\n\
            add_header content-type "$real_mtype";\n\
        }\n\
\n\
        location /assets {\n\
            proxy_pass http://localhost:6060/assets;\n\
            recursive_error_pages on;\n\
            proxy_intercept_errors on;\n\
            error_page 301 302 307 = @handle_redirect;\n\
        }\n\
\n\
        location /internal/assets {\n\
            internal;\n\
            alias /opt/data/assets;\n\
            add_header x-internal-redirect "$upstream_http_x_accel_redirect";\n\
        }\n\
\n\
        location /api/export {\n\
            proxy_pass http://localhost:6061;\n\
        }\n\
\n\
        location /api {\n\
            proxy_pass http://localhost:6060/api;\n\
            proxy_buffering off;\n\
        }\n\
\n\
        location /readyz {\n\
            proxy_pass http://localhost:6060$request_uri;\n\
        }\n\
\n\
        location /ws/notifications {\n\
            proxy_set_header Upgrade $http_upgrade;\n\
            proxy_set_header Connection '"'"'upgrade'"'"';\n\
            proxy_pass http://localhost:6060/ws/notifications;\n\
        }\n\
\n\
        include /etc/nginx/overrides/server.d/*.conf;\n\
\n\
        location / {\n\
            include /etc/nginx/overrides/location.d/*.conf;\n\
\n\
            location ~ ^/js/config.js$ {\n\
                add_header Cache-Control "no-store, no-cache, max-age=0" always;\n\
            }\n\
\n\
            location ~* \\.(js|css|jpg|svg|png|mjs|map)$ {\n\
                add_header Cache-Control "max-age=604800" always;\n\
            }\n\
\n\
            location ~ ^/(/|css|fonts|images|js|wasm|mjs|map) {\n\
            }\n\
\n\
            location ~ ^/[^/]+/(.*)$ {\n\
                return 301 " /404";\n\
            }\n\
\n\
            add_header Last-Modified $date_gmt;\n\
            add_header Cache-Control "no-store, no-cache, max-age=0" always;\n\
            if_modified_since off;\n\
            try_files $uri /index.html$is_args$args /index.html =404;\n\
        }\n\
    }\n\
}\n' > /tmp/nginx-port.conf.template

# Create supervisor configuration using echo (avoiding printf % conflicts)
RUN echo '[supervisord]' > /etc/supervisor/conf.d/supervisord.conf && \
    echo 'nodaemon=true' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'logfile=/tmp/supervisord.log' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'logfile_maxbytes=0' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'pidfile=/tmp/supervisord.pid' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo '' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo '[program:backend]' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'command=/bin/bash /opt/penpot/backend/run-with-env.sh' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'directory=/opt/penpot/backend' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'user=penpot' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'autostart=true' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'autorestart=true' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'stdout_logfile=/dev/stdout' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'stdout_logfile_maxbytes=0' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'stderr_logfile=/dev/stderr' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'stderr_logfile_maxbytes=0' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo '' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo '[program:nginx]' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'command=/bin/bash -c "envsubst '"'"'$PORT,$PENPOT_HTTP_SERVER_MAX_MULTIPART_BODY_SIZE'"'"' < /tmp/nginx-port.conf.template > /tmp/nginx/nginx.conf && exec nginx -c /tmp/nginx/nginx.conf -g '"'"'daemon off;'"'"'"' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'user=penpot' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'autostart=true' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'autorestart=true' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'stdout_logfile=/dev/stdout' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'stdout_logfile_maxbytes=0' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'stderr_logfile=/dev/stderr' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'stderr_logfile_maxbytes=0' >> /etc/supervisor/conf.d/supervisord.conf

# Create entrypoint script
RUN printf '#!/usr/bin/env bash\n\
\n\
#########################################\n\
## Air Gapped config\n\
#########################################\n\
\n\
if [[ $PENPOT_FLAGS == *"enable-air-gapped-conf"* ]]; then\n\
    rm /etc/nginx/overrides/location.d/external-locations.conf;\n\
    export PENPOT_FLAGS="$PENPOT_FLAGS disable-google-fonts-provider disable-dashboard-templates-section"\n\
fi\n\
\n\
#########################################\n\
## App Frontend config\n\
#########################################\n\
\n\
update_flags() {\n\
  if [ -n "$PENPOT_FLAGS" ]; then\n\
    echo "$(sed \\\n\
      -e "s|^//var penpotFlags = .*;|var penpotFlags = \\"$PENPOT_FLAGS\\";|g" \\\n\
      "$1")" > "$1"\n\
  fi\n\
}\n\
\n\
update_flags /var/www/app/js/config.js\n\
\n\
#########################################\n\
## Environment defaults\n\
#########################################\n\
\n\
export PORT=${PORT:-8080}\n\
export PENPOT_HTTP_SERVER_MAX_MULTIPART_BODY_SIZE=${PENPOT_HTTP_SERVER_MAX_MULTIPART_BODY_SIZE:-367001600}\n\
\n\
# Backend defaults\n\
export PENPOT_FLAGS=${PENPOT_FLAGS:-disable-email-verification}\n\
export PENPOT_DATABASE_URI=${PENPOT_DATABASE_URI:-postgresql://penpot-postgres/penpot}\n\
export PENPOT_REDIS_URI=${PENPOT_REDIS_URI:-redis://penpot-redis/0}\n\
export PENPOT_ASSETS_STORAGE_BACKEND=${PENPOT_ASSETS_STORAGE_BACKEND:-assets-fs}\n\
export PENPOT_STORAGE_ASSETS_FS_DIRECTORY=${PENPOT_STORAGE_ASSETS_FS_DIRECTORY:-/opt/data/assets}\n\
export PENPOT_TELEMETRY_ENABLED=${PENPOT_TELEMETRY_ENABLED:-false}\n\
\n\
# OSC hostname configuration\n\
if [ -n "$OSC_HOSTNAME" ]; then\n\
    export PENPOT_PUBLIC_URI="https://$OSC_HOSTNAME"\n\
    echo "OSC_HOSTNAME detected: Setting PENPOT_PUBLIC_URI to $PENPOT_PUBLIC_URI"\n\
else\n\
    export PENPOT_PUBLIC_URI=${PENPOT_PUBLIC_URI:-http://localhost:$PORT}\n\
fi\n\
\n\
PENPOT_DEFAULT_INTERNAL_RESOLVER="$(awk '"'"'BEGIN{ORS=" "} $1=="nameserver" { sub(/%%.*$/,"",$2); print ($2 ~ ":")? "["$2"]": $2}'"'"' /etc/resolv.conf)"\n\
export PENPOT_INTERNAL_RESOLVER=${PENPOT_INTERNAL_RESOLVER:-$PENPOT_DEFAULT_INTERNAL_RESOLVER}\n\
envsubst "\\$PENPOT_INTERNAL_RESOLVER" \\\n\
         < /tmp/resolvers.conf.template > /etc/nginx/overrides/http.d/resolvers.conf\n\
\n\
exec "$@"\n' > /entrypoint-combined.sh

# Create a simple backend wrapper that ensures environment variables are set
RUN echo '#!/bin/bash' > /opt/penpot/backend/run-with-env.sh && \
    echo 'exec /opt/penpot/backend/run.sh' >> /opt/penpot/backend/run-with-env.sh && \
    chmod +x /opt/penpot/backend/run-with-env.sh

RUN chmod +x /entrypoint-combined.sh && \
    chown penpot:penpot /entrypoint-combined.sh

USER penpot:penpot
WORKDIR /opt/penpot/backend

EXPOSE ${PORT:-8080}

ENTRYPOINT ["/bin/bash", "/entrypoint-combined.sh"]
CMD ["bash", "-c", "exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf"]